{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cutecaptain",
  "version": "0.1.0",
  "identifier": "ai.captainspace.cutecaptain",
  "build": {
    "beforeDevCommand": "npm run build:voice && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && npm run bundle:extension && npm run bundle:server && npm run build:voice",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "cutecaptain",
        "url": "index.html",
        "width": 1120,
        "height": 740,
        "minWidth": 760,
        "minHeight": 520,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 22
        },
        "visible": true
      },
      {
        "label": "panel",
        "title": "cutecaptain",
        "url": "panel.html",
        "width": 400,
        "height": 420,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": true,
        "visibleOnAllWorkspaces": true
      },
      {
        "label": "orb",
        "title": "cutecaptain voice",
        "url": "orb.html",
        "width": 100,
        "height": 108,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "acceptFirstMouse": true,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "shortDescription": "cutecaptain in your menu bar",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    },
    "resources": {
      "resources/server": "server",
      "resources/extension": "extension"
    },
    "externalBin": [
      "binaries/captain-voice",
      "binaries/captain-desk"
    ]
  }
}
