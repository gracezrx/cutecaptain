{
  "manifest_version": 3,
  "name": "cutecaptain",
  "version": "0.1.0",
  "description": "Send pages to your team and agents, approve what agents want to do, chat with Captain next to any tab, and let agents work in your Chrome.",
  "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"},
  "action": {
    "default_title": "cutecaptain",
    "default_popup": "extension/popup.html",
    "default_icon": {"16": "icons/16.png", "32": "icons/32.png"}
  },
  "side_panel": {"default_path": "extension/sidepanel.html"},
  "background": {"service_worker": "background.js", "type": "module"},
  "permissions": ["storage", "contextMenus", "sidePanel", "activeTab", "scripting", "alarms", "tabs", "tabGroups"],
  "optional_permissions": ["debugger"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "optional_host_permissions": ["<all_urls>"],
  "commands": {
    "_execute_action": {
      "suggested_key": {"default": "Alt+Shift+C"},
      "description": "Open Captain"
    }
  }
}
