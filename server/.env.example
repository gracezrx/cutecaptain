# Captain server settings. Copy to server/.env (local) or ../.env (Docker
# Compose), or set them in your host's dashboard. To go live you need
# APP_SECRET and DATABASE_URL; model keys can be pasted in the app later.

# Never commit a filled-in copy of this file.

# ---------------------------------------------------------------- basics
# Random, at least 32 characters. Generate: openssl rand -hex 32
# Signs file links and encrypts model keys saved in Settings. If it changes,
# saved keys can't be read anymore and have to be pasted again.
APP_SECRET=
# The address people open (used in invite links).
PUBLIC_URL=http://localhost:8080
PORT=8080
# Postgres 14 or newer. For Supabase, use the session pooler address from
# Connect → Session pooler (port 5432), not the transaction pooler (6543):
#   postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# TLS is turned on automatically for Supabase, Neon and Render addresses.
DATABASE_URL=postgres://postgres@127.0.0.1:5432/captain
# Connections per instance. Keep instances × (this + 2) under your database's limit.
# DATABASE_POOL_SIZE=10
# DATABASE_SSL=require         # force TLS for other hosts; "disable" turns it off
# Anyone can sign up and create a workspace (true), or only people with an invite link (false).
# The first person can always sign up, to set the server up. Model keys are shared by every
# workspace, so on a public address "false" keeps strangers from spending your credit.
OPEN_SIGNUP=true
# Proxies in front of the server: 1 behind one load balancer (Render, Fly, Railway), false when
# exposed directly. Client IPs (rate limits, audit log) are read from X-Forwarded-For only that far.
TRUST_PROXY=false
# People who run this server (paste model keys in Settings), by email, comma-separated.
# When set, exactly these people; when empty, the first person to sign up. Emails aren't
# verified yet, so sign up with your address right after deploying.
# INSTANCE_ADMINS=you@example.com
# Browser origins allowed to call the API besides the server itself (the Mac app's are included).
# CORS_ORIGINS=tauri://localhost,http://tauri.localhost,http://localhost:1420

# ---------------------------------------------------------------- models
# The easy way: sign in as the person who runs the server and paste a key in
# Settings → Models & spend. Keys there are stored encrypted and win over these.
# Or set any of these; the router uses every model whose provider has a key
# (see config/models.json). OpenRouter alone covers all of Captain's models.
OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# DEEPSEEK_API_KEY=
# DASHSCOPE_API_KEY=
# SILICONFLOW_API_KEY=
# MOONSHOT_API_KEY=
# Any OpenAI-compatible gateway (for example Captain's Yunwu account):
# LLM_GATEWAY_URL=https://example.com/v1
# LLM_GATEWAY_KEY=

# With no key at all, agents answer with a built-in demo model so you can click through everything.
LLM_DEMO_FALLBACK=true
# Longest answer any one model call asks for (OpenRouter refuses low-credit
# accounts when this is unbounded), and calls at once per provider.
LLM_MAX_OUTPUT_TOKENS=4000
LLM_MAX_CONCURRENT_PER_PROVIDER=4
# Ask a cheap model to rate difficulty when the heuristics say easy/balanced (one extra small call).
ROUTER_LLM_CLASSIFIER=false

# ---------------------------------------------------------------- agent tools
# Web search for agents (either one).
TAVILY_API_KEY=
# BRAVE_SEARCH_API_KEY=
# Email that agents send after a person approves, e.g. smtps://user:pass@smtp.example.com:465
SMTP_URL=
MAIL_FROM=Captain <captain@example.com>
# Email recipients per workspace per day (stops an open sign-up from becoming a spam relay).
EMAIL_DAILY_LIMIT=100
# The monthly AI budget (USD) each new workspace starts with; "none" for no limit.
DEFAULT_WORKSPACE_BUDGET_USD=20

# ---------------------------------------------------------------- limits
# AGENT_MAX_PARALLEL=3         # plan steps running at once
# AGENT_MAX_PLAN_STEPS=6
# AGENT_MAX_TOOL_ROUNDS=6
# AGENT_MAX_COMPUTER_ROUNDS=80  # when an agent works on a person's Mac or Chrome: a look, click or keystroke each
# WORKER_CONCURRENCY=4         # agent jobs per server
# MAX_UPLOAD_MB=25
# RATE_LIMIT_PER_MINUTE=600
# AUTH_RATE_LIMIT_PER_MINUTE=20
# FILES_DIR=./data/files
# LOG_LEVEL=info
