{
  "name": "captain-server",
  "private": true,
  "version": "0.1.0",
  "description": "Captain's backend: workspaces, chat, real-time, model routing and multi-agent orchestration.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/src/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/db/migrate-cli.ts",
    "test": "CAPTAIN_IGNORE_ENV_FILE=1 node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "test:extension": "CAPTAIN_IGNORE_ENV_FILE=1 node --import tsx --test --test-concurrency=1 test/e2e/*.e2e.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/multipart": "^10.1.6",
    "@fastify/static": "^10.1.8",
    "@fastify/websocket": "^11.3.4",
    "docx": "^9.5.1",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.7",
    "jszip": "3.10.1",
    "marked": "^15.0.12",
    "nodemailer": "^8.0.11",
    "pdfkit": "^0.17.2",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "pptxgenjs": "^3.12.0",
    "undici": "^7.30.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/ws": "^8.18.2",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
